# Copy to .env.local for local dev. All optional locally.

# Password for your dashboard. Required in production (the app locks itself without it).
OWNER_PASSWORD=

# Database. Leave empty locally to use data/relay-v2.db.
# Production: a Turso database URL and token (free plan).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# AI adaptation through Vercel AI Gateway. Without it, Relay trims the client's
# own words to fit instead of rewriting. On Vercel, prefer OIDC (vercel env pull)
# and set a budget in the AI Gateway dashboard.
AI_GATEWAY_API_KEY=
# RELAY_AI_MODEL=anthropic/claude-haiku-4.5
